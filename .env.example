# ==============================================================================
# .env.example — 复制为 .env 并按需修改
# ==============================================================================

# 你的 GitHub 用户名/组织名（ghcr.io 镜像路径用）
IMAGE_OWNER=your-username

# 模型文件名（放在 ./models/ 目录下）
TARGET_MODEL=Qwen3.8-27B-Q4_K_M.gguf
DRAFT_MODEL=Qwen3.8-27B-DFlash2-Q4_K_M.gguf

# 投机解码参数
SPEC_N_MAX=4

# 上下文大小
CTX_SIZE=32768

# GPU 层数（99=全部放 GPU）
NGL=99
NGLD=99
